# Copy to deploy/.env on the VPS and fill in. Never commit .env.
IMAGE_TAG=latest-commit-sha
POSTGRES_PASSWORD=
JWT_SECRET=                 # openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=      # without @
GOOGLE_CLIENT_ID=
TELEGRAM_WEBHOOK_SECRET=    # openssl rand -hex 24
MAIL_FROM=DTM AI <no-reply@dtm-ai.uz>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OPENROUTER_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dtmai      # media.dtm-ai.uz.conf hardcodes this bucket name
# Public media origin (edge nginx -> rustfs bucket media/ prefix, read-only). Web/admin images are built in CI with
# NEXT_PUBLIC_MEDIA_URL=<same value>.
MEDIA_URL=https://media.dtm-ai.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Payments are off by default (all features free while off). Set true only with all four CLICK_* values filled:
# the API refuses to start in prod otherwise.
PAYMENTS_ENABLED=false
# JSON list of Click server IPs/CIDRs allowed to call prepare/complete; [] = no IP restriction.
# Behind edge nginx the peer is the proxy; the app trusts X-Forwarded-For (FORWARDED_ALLOW_IPS, pinned to the
# compose subnet 172.28.0.0/16) so this list is matched against the real Click server IP.
# Example: CLICK_ALLOWED_IPS=["185.8.212.0/24"] (take the current ranges from Click's docs).
CLICK_ALLOWED_IPS=[]
